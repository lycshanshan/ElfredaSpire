<Project Sdk="Godot.NET.Sdk/4.5.1">
  <!-- 导入本地配置文件 -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <!-- 修改 .NET 运行时的版本 -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.0.6</Version>
    <RitsuLibReferenceTarget>0.113.0</RitsuLibReferenceTarget>
    <PackageDir>$(MSBuildProjectDirectory)\artifacts\$(MSBuildProjectName)</PackageDir>

    <!-- 如果 Local.props 未设置路径，报错 -->
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">ERROR_MISSING_STS2_DIR</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>

  <Import Project="$(RitsuLibDir)\RitsuLib.References.props" Condition="Exists('$(RitsuLibDir)\RitsuLib.References.props')" />

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ElfredaSpire\scripts\Characters\Elfreda\Potions\" />
    <Folder Include="ElfredaSpire\scripts\Characters\Elfreda\Events\" />
    <Folder Include="ElfredaSpire\scripts\Characters\Elfreda\Relics\" />
  </ItemGroup>

  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')" Text="请在 Local.props 中配置游戏 0.113.1 的 Sts2Dir。" />
    <Error Condition="!Exists('$(RitsuLibDir)\RitsuLib.References.props')" Text="请在 Local.props 中配置完整 RitsuLib 0.6.15 运行包的 RitsuLibDir。" />
  </Target>

  <Target Name="PackageMod" AfterTargets="Build">
    <MakeDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\$(MSBuildProjectName).json" DestinationFolder="$(PackageDir)" />
  </Target>

  <Target Name="ExportPckRider" AfterTargets="Publish" DependsOnTargets="ExportPck" Condition="'$(IsInnerGodotExport)' != 'true'" />

  <Target Name="ExportPck">
    <MakeDir Directories="$(PackageDir)" />
    <Exec Command="&quot;$(GodotEXEPath)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;Windows Desktop&quot; &quot;$(PackageDir)/$(MSBuildProjectName).pck&quot;"
      EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1" />
  </Target>
</Project>
